{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#d6acff",
          "template": "{{ .Icon }} ",
          "options": {
            "windows": "",
            "linux": ""
          }
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#d6acff",
          "options": {
            "style": "full"
          },
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FFFFFF",
          "template": "in "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#f8e044",
          "options": {
            "style": "full"
          },
          "template": " {{ path .Path .Location }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#d6acff",
          "options": {
            "branch_ahead_icon": "",
            "branch_behind_icon": "",
            "branch_gone_icon": "",
            "branch_icon": "",
            "branch_identical_icon": "",
            "cherry_pick_icon": "",
            "commit_icon": "",
            "fetch_status": true,
            "merge_icon": "",
            "rebase_icon": "",
            "revert_icon": "",
            "tag_icon": ""
          },
          "template": "<#FFFFFF>on</> 󰘬 {{ .HEAD }}{{ if .Staging.Changed }}<#87FF00> ● {{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }}<#D75F00> ● {{ .Working.String }}</>{{ end }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#f8e044",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true,
            "fetch_version": true,
            "display_default": false,
            "folder_name_fallback": false
          },
          "template": "{{ if .Venv }}<#FFFFFF>via</>  {{ .Venv }} {{ .Full }} {{ end }}"
        },
        {
          "type": "wakatime",
          "style": "plain",
          "foreground": "#30acff",
          "template": "<#FFFFFF>at</>  {{ secondsRound .CumulativeTotal.Seconds }} ",
          "options": {
            "url": "https://wakatime.com/api/v1/users/current/summaries?start=today&end=today&api_key={{ .Env.WAKATIME_API_KEY }}",
            "http_timeout": 2000
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FFFFFF",
          "template": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FFFFFF",
          "template": "❯ "
        }
      ]
    }
  ],
  "version": 4
}
